# Copy this file to .env and fill in real values. Never commit the real .env file.

# --- Database ---
DATABASE_URL=postgresql://sdhub_user:CHANGE_ME@localhost:5432/sdhub

# --- Auth ---
# Generate a real secret with: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
JWT_EXPIRES_MINUTES=720

# --- Server ---
PORT=4000

# --- CORS ---
# Comma-separated list of origins allowed to call this API (your dashboard's URL).
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:4000
